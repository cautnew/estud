# Production overrides on top of .env.example. Copy to .env on the server
# (or set these as real environment variables/secrets in your platform)
# and fill in the blanks — never commit the real .env.

APP_NAME=Estu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=estu
DB_USERNAME=estu
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Nginx sits in front of PHP-FPM as a reverse proxy on the same Docker
# network; trust it (and any load balancer in front of it) so
# request()->secure()/ip() reflect the real client.
TRUSTED_PROXIES=*

# Switch to "redis" only if PULSE_REDIS_CONNECTION is configured and the
# `pulse:work` process is running (see docker/supervisor/supervisord.conf);
# otherwise entries queue up and the dashboard stays empty.
PULSE_INGEST_DRIVER=storage

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
